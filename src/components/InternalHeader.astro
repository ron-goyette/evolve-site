---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { 
    label: 'Services', 
    children: [
      { label: 'Individual Therapy', href: '/services/individual-therapy' },
      { label: 'Brainspotting', href: '/services/brainspotting' },
      { label: 'Faith-Based Counseling', href: '/services/faith-based-counseling' },
      { label: 'Clinical Supervision', href: '/services/clinical-supervision' },
    ]
  },
  { label: 'Contact', href: 'https://evolve-wellness.clientsecure.me/contact-widget', target: '_blank' },
];
---

<header class="sticky top-0 w-full z-50 bg-[hsl(var(--primary))] border-b border-white/10 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img src="/Evolve-Logo-600px.png" alt="Evolve Counseling Logo" class="h-32 w-auto" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        link.children ? (
          <div class="relative group py-2">
            <span class="text-sm font-medium text-[hsl(var(--primary-foreground))] hover:opacity-80 transition-opacity flex items-center gap-1 cursor-default">
              {link.label}
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <div class="w-56 bg-[hsl(var(--primary))] border border-white/10 rounded-md shadow-lg py-2 flex flex-col">
                {link.children.map((child) => (
                  <a href={child.href} class="px-4 py-2 text-sm text-[hsl(var(--primary-foreground))] hover:bg-white/10 transition-colors">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a 
            href={link.href} 
            target={link.target || undefined} 
            rel={link.target ? "noopener noreferrer" : undefined} 
            class="text-sm font-medium text-[hsl(var(--primary-foreground))] hover:opacity-80 transition-opacity"
          >
            {link.label}
          </a>
        )
      ))}
      <a href="https://evolve-wellness.clientsecure.me" target="_blank" rel="noopener noreferrer" class="px-4 py-2 text-xs uppercase tracking-wider font-semibold rounded-full bg-orange-500 text-white hover:bg-orange-600 transition shadow-sm">
        Client Portal
      </a>
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button id="mobile-menu-btn-internal" class="md:hidden p-2 text-[hsl(var(--primary-foreground))] focus:outline-none" aria-label="Toggle Menu">
      <svg id="menu-icon-internal" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon-internal" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu-internal" class="hidden md:hidden border-t border-white/10 bg-[hsl(var(--primary))] px-6 py-8 flex flex-col gap-6 text-center">
    {navLinks.map((link) => (
      link.children ? (
        <div class="flex flex-col gap-3">
          <span class="text-xl font-playfair text-[hsl(var(--primary-foreground))] cursor-default">
            {link.label}
          </span>
          <div class="flex flex-col gap-2 bg-white/5 py-4 rounded-lg mx-4 shadow-inner">
            {link.children.map((child) => (
              <a href={child.href} class="mobile-nav-link-internal text-base text-[hsl(var(--primary-foreground))] hover:opacity-80 transition-opacity">
                {child.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a 
          href={link.href} 
          target={link.target || undefined} 
          rel={link.target ? "noopener noreferrer" : undefined} 
          class="mobile-nav-link-internal text-xl font-playfair text-[hsl(var(--primary-foreground))] hover:opacity-80 transition-opacity"
        >
          {link.label}
        </a>
      )
    ))}
    <a href="https://evolve-wellness.clientsecure.me/contact-widget" target="_blank" rel="noopener noreferrer" class="mobile-nav-link-internal mt-2 py-3 w-full text-center font-medium rounded-full bg-orange-500 text-white shadow-md hover:bg-orange-600 transition-colors">
      Get in Touch
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn-internal');
  const menu = document.getElementById('mobile-menu-internal');
  const menuIcon = document.getElementById('menu-icon-internal');
  const closeIcon = document.getElementById('close-icon-internal');
  const links = document.querySelectorAll('.mobile-nav-link-internal');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden', !isOpen);
      closeIcon.classList.toggle('hidden', isOpen);
    });
  }

  if (links.length > 0) {
    links.forEach(link => {
      link.addEventListener('click', () => {
        if (menu && menuIcon && closeIcon) {
          menu.classList.add('hidden');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      });
    });
  }
</script>
<section class="py-24 px-4 bg-[hsl(var(--background))]">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12">
    <!-- Image Column -->
    <div class="w-full md:w-1/2 flex justify-center">
      <img 
        src="/Portia_Goyette_LMFT.webp" 
        alt="Portia Goyette, LMFT" 
        class="rounded-full aspect-square w-[250px] md:w-[300px] lg:w-[350px] object-cover shadow-lg border-4 border-white"
      />
    </div>
    
    <!-- Text Column -->
    <div class="w-full md:w-1/2 space-y-6 text-center md:text-left">
      <h2 class="font-playfair text-3xl md:text-4xl text-[hsl(var(--foreground))]">
        Hello, my name is Portia
      </h2>
      <p class="text-[hsl(var(--muted-foreground))] leading-relaxed text-lg font-light">
        Each one of us is in a constant state of evolution. As we live out our personal stories, we will inevitably experience phases of contentment and joy, turmoil and darkness, and all that exists in between. Nurturing our spirit and emotional wellbeing allows us to expand our capacity for self-reflection, self-awareness, and meaning-making, thereby paving the way for living a more authentic and fulfilling life.
      </p>
      <div class="pt-4">
        <a href="/about" class="inline-block px-6 py-3 text-sm font-semibold tracking-wider uppercase rounded-full border-2 border-[hsl(var(--primary))] text-[hsl(var(--primary))] hover:bg-[hsl(var(--primary))] hover:text-[hsl(var(--primary-foreground))] transition-colors">
          Learn More About Me
        </a>
      </div>
    </div>
  </div>
</section>
---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/#services' },
  { label: 'Posts', href: '/posts' },
  { label: 'Contact', href: 'https://evolve-wellness.clientsecure.me/contact-widget' },
];
---

<header class="absolute top-0 left-0 w-full z-50 bg-transparent border-none">
  <!--Logo -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img src="/Evolve-Logo-600px.png" alt="Evolve Counseling Logo" class="h-32 w-auto" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-white hover:text-stone-300 transition-colors">
          {link.label}
        </a>
      ))}
    <a class="inline-flex items-center justify-center whitespace-nowrap text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-10 rounded-full px-6 py-4 bg-orange-500 hover:bg-orange-700 text-white font-semibold text-white font-semibold" rel="noopener noreferrer" target="_blank" href="https://evolve-wellness.clientsecure.me">Client Scheduling</a>
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-white focus:outline-none" aria-label="Toggle Menu">
      <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[hsl(var(--border))] bg-[hsl(var(--background))] px-6 py-8 flex flex-col gap-6 text-center">
    {navLinks.map((link) => (
      <a href={link.href} class="mobile-nav-link text-xl font-playfair hover:text-[hsl(var(--muted-foreground))]">
        {link.label}
      </a>
    ))}
    <a href="#contact" class="mobile-nav-link mt-2 py-3 w-full text-center font-medium rounded-full bg-orange-500 text-white">
      Client Portal
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>